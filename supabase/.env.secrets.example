# Скопировать в supabase/.env.secrets и подставить секрет. Файл в .gitignore.
# Заливка:  supabase secrets set --env-file supabase/.env.secrets

# JWT Secret проекта Supabase: Dashboard → Settings → API → JWT Settings → JWT Secret.
# Имя без префикса SUPABASE_ — он зарезервирован платформой.
APP_JWT_SECRET=<сюда JWT Secret проекта>

# ID обоих Power-Up'ов (публичные идентификаторы, не секрет).
# Проверено 2026-08-29 через api.trello.com/1/plugins/<id>: оба существуют (401 вместо 404).
TRELLO_PLUGIN_IDS=682c19fcd2c2384f846488ba,6820cde08a0bdf6e5737b5fd

# Origin'ы обоих деплоев Power-Up'а.
ALLOWED_ORIGINS=https://trello-tnm-powerup.pages.dev,https://zelyakin.github.io
